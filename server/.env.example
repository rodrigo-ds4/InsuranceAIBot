# --- LLM (Groq — free tier, get a key at console.groq.com) ---
GROQ_API_KEY=
# Generator model (strong, free tier)
LLM_MODEL=llama-3.3-70b-versatile
# Cheap evaluator used for faithfulness scoring
EVAL_MODEL=llama-3.1-8b-instant

# --- Embeddings (HuggingFace, local & free) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Data / vector DB ---
DATA_DIR=./data
POLICIES_DIR=./data/policies
CHROMA_DIR=./data/chroma
POLICIES_COLLECTION=insurance_policies
MEMORY_COLLECTION=conversation_memory

# --- Retrieval ---
TOP_K=4
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Guardrails ---
MAX_INPUT_CHARS=500
MEMORY_SHORT_WINDOW=6

# --- Server ---
SECRET_KEY=change-me
CORS_ALLOWED_ORIGINS=*
PORT=5000